# VideoTranslator Studio — environment variables (copy to .env and fill in)
#
# Skopíruj ako:  cp .env.example .env
# .env je v .gitignore — nezaspí to do repa.

# ─── API kľúče (voliteľné — len ak chceš API preklady namiesto local Gemma) ───
# OPENAI_API_KEY=sk-...
# GROK_API_KEY=xai-...
# GEMINI_API_KEY=...
# HF_API_KEY=hf_...        # pre HuggingFace gated modely

# ─── Cesty (voliteľné — auto-detect je default) ───────────────────────────────
# VTS_PYTHON=/path/to/python                        # explicit interpreter
# VTS_CONDA_ROOT=/path/to/miniforge3                # conda installation
# VTS_PYTHON_ENV=videotranslator                    # conda env name

# ─── Narrátor cesty (voliteľné) ───────────────────────────────────────────────
# VTS_NARRATOR_SCRIPT=/path/to/notes_to_audio_omnivoice.py
# VTS_NARRATOR_PYTHON=/path/to/f5tts_env/bin/python
# VTS_NARRATOR_VOICES_DIR=/path/to/voices
# VTS_NARRATOR_OUT_DIR=/path/to/narration/output
